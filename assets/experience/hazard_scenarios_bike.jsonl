// 原付・バイク免許コレ！「危険予測シナリオ」データ(AI下書き由来・専門家確認済み)。
// 架空の場面を自作したもの。法令の条文や既存の問題文は転載していない。専門家確認済みのため contentStatus(ai-draft)は外している。
{"scenarioId": "bike_hazard-0001", "title": "危険予測(1) 見通しの悪い交差点とすり抜け", "description": "見通しの悪い交差点や渋滞の横を通る場面で、死角と相手の動きをどう読むかを選びます。", "chapters": [{"chapterId": "s1", "situation": "【場面1】住宅街の見通しの悪い交差点に近づいている。左右は塀で見えず、一時停止の標識はこちら側にない。", "choices": [{"choiceId": "c1", "text": "クラクションを鳴らして、相手に気づかせながら通過する", "isRecommended": false, "feedback": "警音器は、決められた場面以外では頼りにしない。まず減速して自分の目で確かめる。"}, {"choiceId": "c2", "text": "交差点の手前で速度を落とし、左右を確認できる位置まで慎重に進む", "isRecommended": true, "feedback": "見通しの悪い場所では、自分に優先があっても相手が見えているとは限らない。速度を落として確認できる状態にするのが基本。"}, {"choiceId": "c3", "text": "優先道路なので速度はそのままで通過する", "isRecommended": false, "feedback": "優先があっても、飛び出してくる車や自転車がいる可能性は残る。死角では減速が先。"}]}, {"chapterId": "s2", "situation": "【場面2】渋滞で止まっている車列の左側にすき間がある。前方の様子は、前の車に隠れて見えない。", "choices": [{"choiceId": "c1", "text": "すき間が広く見えるので、そのまま加速してすり抜ける", "isRecommended": false, "feedback": "車列の間は、ドアの開閉や歩行者、右左折車の動きが見えにくい。加速して通るのは危険が大きい。"}, {"choiceId": "c2", "text": "すり抜けは控え、車列の流れに合わせて安全な間隔で待つ", "isRecommended": true, "feedback": "無理にすり抜けず流れに合わせるのが安全。急ぐ気持ちより、見えない危険を減らすことを優先する。"}, {"choiceId": "c3", "text": "車の横すれすれを、ミラーに当たらないよう慎重に通る", "isRecommended": false, "feedback": "車との間隔が狭いと、ドアが開いたり車が動いたりしたときに避けられない。余裕のない通過は避ける。"}]}, {"chapterId": "s3", "situation": "【場面3】停止している車の列の先に、横道がある。横道から車が出ようとしているかもしれない。", "choices": [{"choiceId": "c1", "text": "横道の手前で速度を落とし、車の動きに注意しながら進む", "isRecommended": true, "feedback": "横道の手前で減速し、出てくる車を想定しておくと、急な動きにも対応しやすい。"}, {"choiceId": "c2", "text": "横道側の車に道を譲るつもりで、手を振って合図する", "isRecommended": false, "feedback": "手を振る合図だけでは意思が伝わらないことがある。止まれる速度で、相手の動きを確かめる。"}, {"choiceId": "c3", "text": "列の車が止まってくれているので、横道には注意せず直進する", "isRecommended": false, "feedback": "列で止まっている車が譲ってくれても、横道の車が出てくることがある。その先は死角になりやすい。"}]}, {"chapterId": "s4", "situation": "【場面4】交差点で右折したい。対向車線に車が続いていて、その陰にバイクがいるかもしれない。", "choices": [{"choiceId": "c1", "text": "対向車が止まったので、確認せず素早く曲がる", "isRecommended": false, "feedback": "止まってくれたように見えても、その陰を別の車両が通ることがある。確認なしの右折は危険。"}, {"choiceId": "c2", "text": "対向車の切れ目を見つけたら、すぐに右折を始める", "isRecommended": false, "feedback": "対向車の陰は死角になり、二輪車は小さくて見落としやすい。切れ目だけで判断しない。"}, {"choiceId": "c3", "text": "対向車の陰に二輪車などがいないか、よく確認してから右折する", "isRecommended": true, "feedback": "大きな車の陰の二輪車や歩行者を確認する習慣が、右折時の事故を減らす。"}]}, {"chapterId": "s5", "situation": "【場面5】信号が青に変わった直後。交差する道では、まだ渡りきっていない車や歩行者が見える。", "choices": [{"choiceId": "c1", "text": "青なので、周りを見ずに素早く発進する", "isRecommended": false, "feedback": "青信号でも、前の信号の残りで進んでくる車や、渡り切れていない歩行者がいる。確認してから動く。"}, {"choiceId": "c2", "text": "交差する側の動きを確かめ、安全を確認してから発進する", "isRecommended": true, "feedback": "発進前の一呼吸の確認が、交差点での事故を避ける。"}, {"choiceId": "c3", "text": "前の車に続いて、同じ勢いでついていく", "isRecommended": false, "feedback": "前の車についていくだけだと、自分の目で確認する機会を失う。自分で安全を確かめる。"}]}], "source": "original", "sourceRef": "自作の架空シナリオ(AI下書き・専門家確認済み)。法令条文・既存問題は転載していない", "contentVer": "2"}
{"scenarioId": "bike_hazard-0002", "title": "危険予測(2) カーブと雨の日の走り方", "description": "ブラインドカーブや雨の日の路面で、速度と姿勢をどう整えるかを選びます。", "chapters": [{"chapterId": "s1", "situation": "【場面1】山あいの道で、先が見えないカーブに近づいている。路肩には落ち葉が積もっている。", "choices": [{"choiceId": "c1", "text": "カーブに入る前に十分に減速し、落ち葉の上を避けて走る位置を選ぶ", "isRecommended": true, "feedback": "先が見えないカーブは、止まれる速度まで入口で落とす。落ち葉は滑りやすいので、避けるか通過中は無理をしない。"}, {"choiceId": "c2", "text": "曲がりながら減速すれば間に合うので、そのまま進入する", "isRecommended": false, "feedback": "曲がっている最中のブレーキは車体が不安定になりやすい。進入前に速度を調整する。"}, {"choiceId": "c3", "text": "対向車はいないはずなので、道の中央寄りを走る", "isRecommended": false, "feedback": "見えない先に対向車や障害物がないとは限らない。道の中央寄りは危険。"}]}, {"chapterId": "s2", "situation": "【場面2】雨が降り出し、路面が濡れてきた。前方の横断歩道の白線やマンホールが光って見える。", "choices": [{"choiceId": "c1", "text": "雨でも普段どおりに走れるので、同じ操作で通る", "isRecommended": false, "feedback": "雨の日は、路面の摩擦が小さくなる。普段より余裕を持った操作が必要。"}, {"choiceId": "c2", "text": "マンホールの上で、強くブレーキをかけて速度を落とす", "isRecommended": false, "feedback": "滑りやすい場所で強く制動すると、タイヤがグリップを失いやすい。減速はその前に行う。"}, {"choiceId": "c3", "text": "マンホールや白線の上は滑りやすいので、できるだけ避けるか、直進で静かに通る", "isRecommended": true, "feedback": "濡れた白線や金属の蓋は特に滑りやすい。避けるか、ブレーキや急な操作をせずに通る。"}]}, {"chapterId": "s3", "situation": "【場面3】雨で前の車との距離が近くなってきた。後ろにも車がついている。", "choices": [{"choiceId": "c1", "text": "距離は気にせず、必要なときだけ強くブレーキをかける", "isRecommended": false, "feedback": "急なブレーキは滑りやすい路面でさらに危険。早めに気づいて、ゆるやかに止まる。"}, {"choiceId": "c2", "text": "前の車との車間を広めにとり、ブレーキは早めにやさしく使う", "isRecommended": true, "feedback": "雨の日は止まるまでの距離が長くなる。車間を広げ、早めの穏やかな操作が安全につながる。"}, {"choiceId": "c3", "text": "後ろの車に合わせて、車間を詰めて走る", "isRecommended": false, "feedback": "後ろの車に合わせて詰めると、前が急に止まったときに対応できない。"}]}, {"chapterId": "s4", "situation": "【場面4】雨の中の走行で、ヘルメットのシールドが曇って前が見えにくくなってきた。", "choices": [{"choiceId": "c1", "text": "見えにくいまま、いつもの速度で走り続ける", "isRecommended": false, "feedback": "視界が悪いまま走るのは危険。安全に止まれる場所で、視界を整えるのが先。"}, {"choiceId": "c2", "text": "安全な場所に停止して視界を確保してから、再び走り出す", "isRecommended": true, "feedback": "走行中に片手を離す操作は、バランスを崩す原因になる。止まって対処する。"}, {"choiceId": "c3", "text": "片手でシールドを拭きながら走る", "isRecommended": false, "feedback": "無理に走り続けず、一度止まって対処する。出発前に曇り止めの準備をしておくのも有効。"}]}, {"chapterId": "s5", "situation": "【場面5】雨が上がったが、路面はまだ濡れている。前方に大きな水たまりがある。", "choices": [{"choiceId": "c1", "text": "水たまりは浅いはずなので、そのまま突っ込む", "isRecommended": false, "feedback": "深さが分からないまま突っ込むと、ハンドルを取られたり転倒したりするおそれがある。"}, {"choiceId": "c2", "text": "勢いをつけて、一気に通過する", "isRecommended": false, "feedback": "勢いをつけると、水の抵抗や下の路面で車体が不安定になる。"}, {"choiceId": "c3", "text": "水たまりの深さが分からないので、速度を落として避けるか、慎重に通る", "isRecommended": true, "feedback": "水たまりの下には、穴や段差があるかもしれない。速度を落とし、避けるか慎重に通る。"}]}], "source": "original", "sourceRef": "自作の架空シナリオ(AI下書き・専門家確認済み)。法令条文・既存問題は転載していない", "contentVer": "2"}
{"scenarioId": "bike_hazard-0003", "title": "危険予測(3) 夜間走行と二人乗り", "description": "暗い道での見え方や、同乗者がいるときの配慮を、場面ごとに選びます。", "chapters": [{"chapterId": "s1", "situation": "【場面1】夜の郊外の道を走っている。街灯が少なく、前方がよく見えない。", "choices": [{"choiceId": "c1", "text": "ライトがあるので、普段の昼と同じ速度で走る", "isRecommended": false, "feedback": "夜は昼より発見が遅れる。同じ速度では、障害物に気づいてから止まれないことがある。"}, {"choiceId": "c2", "text": "前の車の後ろにぴったりついて、先導してもらう", "isRecommended": false, "feedback": "車間を詰めると、前の車が急に止まったときに対処できない。"}, {"choiceId": "c3", "text": "ライトの照らす範囲で止まれるように、速度を落として走る", "isRecommended": true, "feedback": "夜は遠くまで見えにくく、発見が遅れる。ライトで確認できる範囲の中で止まれる速度が目安。"}]}, {"chapterId": "s2", "situation": "【場面2】対向車のライトがまぶしく、一瞬、道の端が見えなくなった。", "choices": [{"choiceId": "c1", "text": "相手のライトを見つめて、車の位置を確かめ続ける", "isRecommended": false, "feedback": "光を見つめ続けると、目がくらんで余計に見えなくなる。"}, {"choiceId": "c2", "text": "視線を少し左前に向けて、速度を落として通り過ぎるのを待つ", "isRecommended": true, "feedback": "まぶしいときは、視線を道の左端付近に向けて直接光を見ない。速度を落とし、通過を待つ。"}, {"choiceId": "c3", "text": "まぶしさに驚いて、急にブレーキをかける", "isRecommended": false, "feedback": "急ブレーキは後続車との接触や転倒につながる。穏やかに減速する。"}]}, {"chapterId": "s3", "situation": "【場面3】夜道で、黒っぽい服の歩行者が道の端を歩いているのに気づくのが遅れた。", "choices": [{"choiceId": "c1", "text": "夜は歩行者を見つけにくい前提で、速度を落とし、間隔をあけて通過する", "isRecommended": true, "feedback": "暗い服装の歩行者は発見しにくい。夜は見落としやすいと想定し、減速して十分な間隔をとる。"}, {"choiceId": "c2", "text": "気づいたので、そのままの速度で横を通る", "isRecommended": false, "feedback": "近くを同じ速度で通ると、ふらつきや急な動きに対応できない。"}, {"choiceId": "c3", "text": "警音器を何度も鳴らして、避けさせる", "isRecommended": false, "feedback": "警音器で相手を動かそうとせず、自分が減速して避ける。"}]}, {"chapterId": "s4", "situation": "【場面4】友人を後ろに乗せて走ることになった。出発前に何を確認するか。", "choices": [{"choiceId": "c1", "text": "時間がないので、説明せずにそのまま出発する", "isRecommended": false, "feedback": "説明なしに出発すると、同乗者の姿勢が崩れて危険になるおそれがある。"}, {"choiceId": "c2", "text": "同乗者は荷物と同じ扱いで、特に気を配らない", "isRecommended": false, "feedback": "同乗者がいると操作の感覚も変わる。人であることを意識して、配慮する。"}, {"choiceId": "c3", "text": "同乗者にもヘルメットと服装を整えてもらい、乗り方や合図を事前に伝える", "isRecommended": true, "feedback": "同乗者の装備と乗り方の説明は安全の基本。体を安定させ、運転者の動きに合わせてもらう。"}]}, {"chapterId": "s5", "situation": "【場面5】二人乗りで走行中。信号で止まる前に、後ろの人の体が前に寄ってきた。", "choices": [{"choiceId": "c1", "text": "同乗者の動きは気にせず、前だけを見る", "isRecommended": false, "feedback": "同乗者の様子も運転の一部。動きに気を配り、無理のない操作をする。"}, {"choiceId": "c2", "text": "普段より早めに、ゆるやかに減速し、停止の動きを伝えやすくする", "isRecommended": true, "feedback": "二人乗りは車体が重く、止まるまでの余裕も変わる。早めのゆるやかな減速が、同乗者の安定にもつながる。"}, {"choiceId": "c3", "text": "いつもと同じタイミングで、急にブレーキをかける", "isRecommended": false, "feedback": "急なブレーキは同乗者の体を前に押し、バランスを崩しやすい。"}]}], "source": "original", "sourceRef": "自作の架空シナリオ(AI下書き・専門家確認済み)。法令条文・既存問題は転載していない", "contentVer": "2"}
{"scenarioId": "bike_hazard-0004", "title": "危険予測(4) 住宅街と駐車車両まわり", "description": "住宅街や路上駐車の脇など、人や車の急な動きが起こりやすい場面での判断を選びます。", "chapters": [{"chapterId": "s1", "situation": "【場面1】住宅街の道。路上に駐車している車の横を通るところで、車のかげは見えない。", "choices": [{"choiceId": "c1", "text": "近くを通るほうが安全なので、車に寄って走る", "isRecommended": false, "feedback": "車に寄ると、ドアが開いたときなどに逃げ場がなくなる。余裕のある間隔をとる。"}, {"choiceId": "c2", "text": "車のかげから人や自転車が出てくるかもしれないと考え、速度を落として進む", "isRecommended": true, "feedback": "駐車車両のかげは死角。子どもや自転車が急に出てくる可能性を想定して、減速して余裕を持つ。"}, {"choiceId": "c3", "text": "駐車車両の横では、いつもの速度で通る", "isRecommended": false, "feedback": "速度がそのままだと、飛び出しに対応できない。"}]}, {"chapterId": "s2", "situation": "【場面2】前を走る車が突然、道の左に寄って止まった。ドアが開きそうな気配がある。", "choices": [{"choiceId": "c1", "text": "ドアの開閉に備えて、間隔をあけて速度を落として通る", "isRecommended": true, "feedback": "止まった車のドアは、突然開くことがある。間隔と速度に余裕を持たせて通る。"}, {"choiceId": "c2", "text": "合図なしに止まったので、車に寄って追い抜く", "isRecommended": false, "feedback": "狭いすき間を無理に抜けると、ドアに接触するおそれがある。"}, {"choiceId": "c3", "text": "ブレーキをかけず、すばやく通りすぎる", "isRecommended": false, "feedback": "ブレーキをかけずに近くを速く通ると、急な動きに対応できない。"}]}, {"chapterId": "s3", "situation": "【場面3】学校や公園の近くの道。ボールが道に転がってきた。", "choices": [{"choiceId": "c1", "text": "ボールをよけながら、そのまま走り続ける", "isRecommended": false, "feedback": "ボールだけをよけても、人が出てくる可能性が残る。"}, {"choiceId": "c2", "text": "子どもが出てこない確認ができるまで加速して通り過ぎる", "isRecommended": false, "feedback": "加速して通り過ぎようとすると、人が出てきたときに避けられない。"}, {"choiceId": "c3", "text": "子どもが追いかけて出てくるかもしれないので、すぐ減速し、停止の準備をする", "isRecommended": true, "feedback": "ボールの後ろには子どもが続くことが多い。すぐ減速して、止まれる準備をする。"}]}, {"chapterId": "s4", "situation": "【場面4】細い路地から、自転車がこちらの道に出ようとしている。こちらが優先の道に見える。", "choices": [{"choiceId": "c1", "text": "警音器を鳴らして、先に通ることを伝える", "isRecommended": false, "feedback": "警音器は決められた場面以外に頼らない。まず減速して、相手の動きを確かめる。"}, {"choiceId": "c2", "text": "優先でも、相手の動きを見て、必要なら止まれる速度に落とす", "isRecommended": true, "feedback": "優先があっても、相手が止まるとは限らない。動きを予測して、止まれる準備をしておく。"}, {"choiceId": "c3", "text": "優先だから、必ず相手が止まると考えて進む", "isRecommended": false, "feedback": "相手が気づいていない場合、衝突につながる。譲り合いの気持ちも大切。"}]}, {"chapterId": "s5", "situation": "【場面5】目的地に着く直前、住宅街の細い道を通ることになった。駐車場の出入口から車が出ようとしている。", "choices": [{"choiceId": "c1", "text": "出入口の車に気づいたら、減速して様子を見て、相手が動くか確認する", "isRecommended": true, "feedback": "出入口の車は歩道や道路の状況を確認しながら出てくる。減速して動きを見て、安全に譲る。"}, {"choiceId": "c2", "text": "出る前に自分が通りすぎるよう、加速して前に出る", "isRecommended": false, "feedback": "加速して前に出ると、相手が出てきたときにぶつかるおそれがある。"}, {"choiceId": "c3", "text": "出入口の車は待たなければならないので、そのまま通る", "isRecommended": false, "feedback": "相手が待つとは限らない。自分で安全を確認することを優先する。"}]}], "source": "original", "sourceRef": "自作の架空シナリオ(AI下書き・専門家確認済み)。法令条文・既存問題は転載していない", "contentVer": "2"}
{"scenarioId": "bike_hazard-0005", "title": "危険予測(5) 雨の日の路面と視界", "description": "雨で路面がすべりやすく、視界も悪くなる場面で、速度やブレーキの使い方をどう整えるかを選びます。", "chapters": [{"chapterId": "s1", "situation": "【場面1】朝から雨が降っている。走り出す前の路面は濡れていて、遠くが見えにくい。", "choices": [{"choiceId": "c1", "text": "いつもより速度を抑え、車間を広めにとって走り出す", "isRecommended": true, "feedback": "濡れた路面は止まるまでの距離が伸びる。速度と車間に余裕を持つのが基本。"}, {"choiceId": "c2", "text": "晴れの日と同じ速度と車間で、時間どおりに走る", "isRecommended": false, "feedback": "路面が濡れると、同じ速度でも止まりにくくなる。晴れの日の感覚のままでは危険。"}, {"choiceId": "c3", "text": "雨具を気にせず、早く着くため速めに走る", "isRecommended": false, "feedback": "急ぐほど、止まる余裕がなくなる。雨の日は到着時間より安全を優先する。"}]}, {"chapterId": "s2", "situation": "【場面2】前方の道路に、マンホールのふたと白い道路標示が続いている。路面は濡れている。", "choices": [{"choiceId": "c1", "text": "速度を保ったまま、ふたの上でハンドルを切って避ける", "isRecommended": false, "feedback": "すべりやすい上でハンドルを切ると、タイヤが横に流れて転倒しやすい。"}, {"choiceId": "c2", "text": "ふたや標示をできるだけ避け、乗るときは車体を起こして通る", "isRecommended": true, "feedback": "濡れたマンホールや標示は特にすべりやすい。車体を起こしたまま通ると転倒しにくい。"}, {"choiceId": "c3", "text": "ふたの上で急ブレーキをかけて、速度を落とす", "isRecommended": false, "feedback": "すべりやすい場所での急ブレーキは、タイヤがロックして転倒の原因になる。"}]}, {"chapterId": "s3", "situation": "【場面3】信号が黄色に変わった。前方の停止線まで距離がある。路面は濡れている。", "choices": [{"choiceId": "c1", "text": "止まれないと困るので、加速して交差点を通過する", "isRecommended": false, "feedback": "黄色で加速するのは、交差点内で危険な状況になりやすい。無理な通過は避ける。"}, {"choiceId": "c2", "text": "停止線の直前まで走り、強くブレーキを握って止まる", "isRecommended": false, "feedback": "直前の強いブレーキは、すべって止まれないおそれがある。早めの減速を心がける。"}, {"choiceId": "c3", "text": "早めにブレーキを数回に分けて握り、余裕を持って止まる", "isRecommended": true, "feedback": "雨の日は早めに、ゆるやかに減速する。止まる余裕があるうちに動くのが安全。"}]}, {"chapterId": "s4", "situation": "【場面4】大きな水たまりが道路の端に広がっている。歩行者が少し先を歩いている。", "choices": [{"choiceId": "c1", "text": "速度を落として水たまりを避け、歩行者に水をかけないようにする", "isRecommended": true, "feedback": "減速して避ければ、すべりや水はねを防げ、歩行者への配慮にもなる。"}, {"choiceId": "c2", "text": "水たまりを勢いよく通り抜けて、歩行者の横も素早く通過する", "isRecommended": false, "feedback": "水たまりの中は路面の状態がわからず、すべる危険がある。水はねで歩行者にも迷惑になる。"}, {"choiceId": "c3", "text": "歩行者の横を、水たまりの有無を気にせずそのままの速度で通る", "isRecommended": false, "feedback": "歩行者への配慮が足りない。水はねを避けるためにも、減速して通ることが大切。"}]}, {"chapterId": "s5", "situation": "【場面5】雨がやんだが、道路はまだ濡れている。ヘルメットのシールドが曇って見える。", "choices": [{"choiceId": "c1", "text": "曇ったままシールドを少し開けて、そのまま走り続ける", "isRecommended": false, "feedback": "開けたまま走ると、雨や風が入って目に入りやすい。視界を確保する根本の解決にならない。"}, {"choiceId": "c2", "text": "安全な場所に止まり、シールドを拭くなどして視界を確保する", "isRecommended": true, "feedback": "視界が悪いままの走行は危険。安全な場所で止まり、見えるようにしてから再び走る。"}, {"choiceId": "c3", "text": "前を走る車のあとについていけば安全なので、そのまま走る", "isRecommended": false, "feedback": "前の車に頼ると、急な変化に気づくのが遅れる。自分で見える状態を保つことが必要。"}]}], "source": "original", "sourceRef": "自作の架空シナリオ(AI下書き・専門家確認済み)。法令条文・既存問題は転載していない", "contentVer": "2"}
{"scenarioId": "bike_hazard-0006", "title": "危険予測(6) 夜間の対向車と見えにくさ", "description": "暗い道で、対向車のライトや歩行者、自転車が見えにくくなる場面での判断を選びます。", "chapters": [{"chapterId": "s1", "situation": "【場面1】夜の道路。前方から対向車が近づき、ヘッドライトがまぶしくて前が見えにくい。", "choices": [{"choiceId": "c1", "text": "ライトを見つめて、相手の位置を確かめ続ける", "isRecommended": false, "feedback": "ライトを見つめ続けると、目がくらんで周りが見えなくなる。"}, {"choiceId": "c2", "text": "まぶしさを避けるため、目を閉じて通り過ぎる", "isRecommended": false, "feedback": "目を閉じると、その間に道路の状況が見えなくなる。非常に危険。"}, {"choiceId": "c3", "text": "視線を左に少しそらし、速度を落として通過を待つ", "isRecommended": true, "feedback": "まぶしいときは視線を左前方にそらし、速度を抑えて道路端の位置を確かめながら進む。"}]}, {"chapterId": "s2", "situation": "【場面2】暗い道の先に、黒っぽい服の人が道路わきを歩いているのがぼんやり見える。", "choices": [{"choiceId": "c1", "text": "減速して、歩行者との間隔を広めにとって通過する", "isRecommended": true, "feedback": "暗い服の人は見つけにくい。速度を落とし、間隔をあけて通過するのが基本。"}, {"choiceId": "c2", "text": "気づいていないかもしれないが、そのまま近くを通る", "isRecommended": false, "feedback": "歩行者が急に動くかもしれない。近くを通ると接触する危険が高い。"}, {"choiceId": "c3", "text": "警音器を何度も鳴らして、人をよけさせる", "isRecommended": false, "feedback": "警音器は決められた場面以外で乱用しない。まず減速して間隔を確保する。"}]}, {"chapterId": "s3", "situation": "【場面3】交差点に近づく。右側の道から、ライトを点けていない自転車が出てきそうに見える。", "choices": [{"choiceId": "c1", "text": "自転車は止まるはずだと考え、速度を保つ", "isRecommended": false, "feedback": "相手が止まるとは限らない。自分で安全を確かめずに進むのは危険。"}, {"choiceId": "c2", "text": "減速して、自転車の動きを確認しながら進む", "isRecommended": true, "feedback": "夜の自転車は見えにくく、動きも読みにくい。減速して動きを確かめるのが安全。"}, {"choiceId": "c3", "text": "ライトをパッシングさせて、先に行かせる", "isRecommended": false, "feedback": "合図だけでは意思が伝わらないこともある。止まれる速度で動きを確認する。"}]}, {"chapterId": "s4", "situation": "【場面4】トンネルを出て、急に暗い道に変わった。路面の状態がよく見えない。", "choices": [{"choiceId": "c1", "text": "明るい場所から出たので、すぐに速度を上げる", "isRecommended": false, "feedback": "慣れる前に加速すると、障害物や路面の状態に気づくのが遅れる。"}, {"choiceId": "c2", "text": "目が慣れないが、ライトを消して様子を見る", "isRecommended": false, "feedback": "ライトを消すと、自分も周りも見えにくくなる。点灯したまま減速する。"}, {"choiceId": "c3", "text": "速度を落として、目が暗さに慣れるのを待つ", "isRecommended": true, "feedback": "明るい場所から暗い場所に入ると、目が慣れるまで時間がかかる。減速して慣れるのを待つ。"}]}, {"chapterId": "s5", "situation": "【場面5】長く走って疲れてきた。夜の道路で眠気を感じ始めた。", "choices": [{"choiceId": "c1", "text": "安全な場所に止まり、休憩をとってから再び走る", "isRecommended": true, "feedback": "眠気を感じたら、無理せず安全な場所で休むのが基本。"}, {"choiceId": "c2", "text": "窓を開ける代わりに、音楽を大きくして走る", "isRecommended": false, "feedback": "音楽などで眠気をごまかしても、反応の遅れは変わらない。"}, {"choiceId": "c3", "text": "目的地が近いので、眠気を我慢して走り続ける", "isRecommended": false, "feedback": "眠気を我慢して走ると、判断の遅れや居眠りにつながり非常に危険。"}]}], "source": "original", "sourceRef": "自作の架空シナリオ(AI下書き・専門家確認済み)。法令条文・既存問題は転載していない", "contentVer": "2"}
{"scenarioId": "bike_hazard-0007", "title": "危険予測(7) 歩行者とバス停まわり", "description": "歩行者や停車中のバスが多い道路で、動きを予測しながら安全に走る場面です。", "chapters": [{"chapterId": "s1", "situation": "【場面1】前方の横断歩道で、歩行者が渡ろうとしているように見える。", "choices": [{"choiceId": "c1", "text": "歩行者より先に通過できるよう、横断歩道の手前で速度を上げる", "isRecommended": false, "feedback": "加速して先に通ろうとするのは、歩行者の通行を妨げる。"}, {"choiceId": "c2", "text": "横断歩道の手前で止まれる速度に落とし、歩行者の動きを確かめる", "isRecommended": true, "feedback": "歩行者が渡ろうとしているときは、止まれる速度にして歩行者を優先する。"}, {"choiceId": "c3", "text": "歩行者に手を振って先に渡るよう合図し、そのまま通過する", "isRecommended": false, "feedback": "合図をしても、歩行者や周りの車に意図が伝わらないことがある。まず止まれる速度にする。"}]}, {"chapterId": "s2", "situation": "【場面2】バスが停留所に止まっている。その横を通って先へ進みたい。", "choices": [{"choiceId": "c1", "text": "バスの横を、前から出てくる人を気にせずそのままの速度で通過する", "isRecommended": false, "feedback": "バスの前後は死角になりやすい。同じ速度で通ると、飛び出しに対応できない。"}, {"choiceId": "c2", "text": "バスの発進を待たずに、右側へ大きく出て素早く追い越す", "isRecommended": false, "feedback": "大きく右へ出ると、対向車と接触する危険がある。無理な進路変更は避ける。"}, {"choiceId": "c3", "text": "速度を落とし、バスの前から出てくる歩行者に注意して進む", "isRecommended": true, "feedback": "バスの陰から歩行者が出てくることがある。減速して注意して進むのが基本。"}]}, {"chapterId": "s3", "situation": "【場面3】バスが方向指示器を出して、停留所から発進しようとしている。", "choices": [{"choiceId": "c1", "text": "無理に追い越さず、バスの動きに合わせて譲る", "isRecommended": true, "feedback": "発進しようとするバスには、状況に応じて進路を譲る。無理に前へ出ない。"}, {"choiceId": "c2", "text": "バスが動く前に、素早く横をすり抜ける", "isRecommended": false, "feedback": "発進直前のバスの横は危険。接触のおそれがある。"}, {"choiceId": "c3", "text": "警音器を鳴らして、バスに先に行かせる", "isRecommended": false, "feedback": "警音器は決められた場面以外では使わない。まず自分が安全に譲る。"}]}, {"chapterId": "s4", "situation": "【場面4】歩道を歩く人が多く、車道に少しはみ出しながら歩いている人もいる。", "choices": [{"choiceId": "c1", "text": "歩道に近いほうを、速度を保ったまま通る", "isRecommended": false, "feedback": "歩道に近い位置を同じ速度で走ると、急な動きに対応できない。"}, {"choiceId": "c2", "text": "歩行者との間隔をとり、速度を落として通る", "isRecommended": true, "feedback": "はみ出している人がいる場所では、間隔をあけて減速し、予期せぬ動きに備える。"}, {"choiceId": "c3", "text": "歩行者が避けると考え、そのまま同じ位置を走る", "isRecommended": false, "feedback": "相手が避けてくれるとは限らない。自分から余裕を作って通る。"}]}, {"chapterId": "s5", "situation": "【場面5】高齢の歩行者が、ゆっくり横断歩道を渡っている。後ろから別の車が近づいてくる。", "choices": [{"choiceId": "c1", "text": "歩行者が渡り終える前に、横断歩道の横をすり抜けて通過する", "isRecommended": false, "feedback": "渡り終える前にすり抜けると、歩行者の通行を妨げ危険。"}, {"choiceId": "c2", "text": "後ろの車に合図を出して、自分より先に行ってもらう", "isRecommended": false, "feedback": "後ろの車を先に行かせると、歩行者の前を通らせてしまう。まず自分が止まって待つ。"}, {"choiceId": "c3", "text": "横断歩道の手前で止まり、歩行者が渡り終えるまで待つ", "isRecommended": true, "feedback": "歩行者が渡り終えるまで待つのが安全。後ろの車にも止まる動きを見せて知らせる。"}]}], "source": "original", "sourceRef": "自作の架空シナリオ(AI下書き・専門家確認済み)。法令条文・既存問題は転載していない", "contentVer": "2"}
{"scenarioId": "bike_hazard-0008", "title": "危険予測(8) 山道のカーブと下り坂", "description": "見通しの悪いカーブや下り坂が続く山道で、速度とブレーキ操作をどう整えるかを選びます。", "chapters": [{"chapterId": "s1", "situation": "【場面1】山道の入口。カーブが連続していて、先は見通せない。", "choices": [{"choiceId": "c1", "text": "カーブの手前で速度を落とし、見える範囲で止まれる速度で進む", "isRecommended": true, "feedback": "見通しが悪いカーブは、見える範囲で止まれる速度が基本。"}, {"choiceId": "c2", "text": "直線の道路のように、速度を保ったままカーブに入って進む", "isRecommended": false, "feedback": "速度を保ってカーブに入ると、曲がりきれなくなるおそれがある。"}, {"choiceId": "c3", "text": "先が見えないので、車線の中央に寄ってカーブを進む", "isRecommended": false, "feedback": "車線の中央に寄ると、対向車と接触する危険がある。自分の車線内を走る。"}]}, {"chapterId": "s2", "situation": "【場面2】カーブの途中で、前方に小石や落ち葉が散らばっているのが見えた。", "choices": [{"choiceId": "c1", "text": "石や落ち葉の上をそのまま踏み越えて、速度を保って進む", "isRecommended": false, "feedback": "石を踏み越えると、タイヤがすべって転倒するおそれがある。"}, {"choiceId": "c2", "text": "減速して、石や落ち葉をなるべく避け、車体を急に傾けない", "isRecommended": true, "feedback": "小石や落ち葉はすべりやすい。減速し、車体を急に傾けずに通るのが安全。"}, {"choiceId": "c3", "text": "ブレーキを強く握って、その場で急停止して様子を見る", "isRecommended": false, "feedback": "カーブ中の強いブレーキは、バランスをくずす原因になる。"}]}, {"chapterId": "s3", "situation": "【場面3】長い下り坂に差しかかった。後ろに車が近づいてくる。", "choices": [{"choiceId": "c1", "text": "ブレーキを使わず、惰性にまかせてそのまま坂を下っていく", "isRecommended": false, "feedback": "惰性で下ると速度が上がり過ぎ、止まれなくなるおそれがある。"}, {"choiceId": "c2", "text": "後続車に先に行かせるため、速度を一気に上げて下る", "isRecommended": false, "feedback": "速度を上げて下ると、カーブなどで対応できなくなる。"}, {"choiceId": "c3", "text": "エンジンブレーキを併用して速度を抑え、一定の間隔を保つ", "isRecommended": true, "feedback": "エンジンブレーキを併用すれば、ブレーキの使い過ぎを防げる。"}]}, {"chapterId": "s4", "situation": "【場面4】カーブの出口付近で、対向車がセンターライン付近を走ってくるのが見えた。", "choices": [{"choiceId": "c1", "text": "減速して、自分の車線の左寄りで安全を確保する", "isRecommended": true, "feedback": "対向車が寄ってきても、自分の車線内で余裕を持って走る。"}, {"choiceId": "c2", "text": "対向車に合わせて、センターライン近くへ寄る", "isRecommended": false, "feedback": "センターライン付近に寄ると、衝突の危険が高まる。"}, {"choiceId": "c3", "text": "対向車を避けるため、急に右へハンドルを切る", "isRecommended": false, "feedback": "急にハンドルを切ると、バランスをくずしたり対向車と接触したりする。"}]}, {"chapterId": "s5", "situation": "【場面5】坂の途中の休憩所で、いったん停止した。ふたたび発進して本線に合流する。", "choices": [{"choiceId": "c1", "text": "本線が見えにくいので、勢いよく飛び出して合流する", "isRecommended": false, "feedback": "勢いよく飛び出すと、走ってくる車が避けられないおそれがある。"}, {"choiceId": "c2", "text": "後続車の様子を確かめ、安全を確認してから発進する", "isRecommended": true, "feedback": "合流前に周囲の車を確かめる。安全を確認してからゆっくり加速して合流する。"}, {"choiceId": "c3", "text": "手で合図を出して、そのまま発進する", "isRecommended": false, "feedback": "合図だけでは不十分。自分で後方と周囲を目で確かめてから発進する。"}]}], "source": "original", "sourceRef": "自作の架空シナリオ(AI下書き・専門家確認済み)。法令条文・既存問題は転載していない", "contentVer": "2"}
{"scenarioId": "bike_hazard-0009", "title": "危険予測(9) 駐車場の出入口と店まわり", "description": "店や駐車場の出入口が続く道路で、車や人の急な動きに備える場面です。", "chapters": [{"chapterId": "s1", "situation": "【場面1】コンビニの前を通る。駐車場から、車が出ようとしているように見える。", "choices": [{"choiceId": "c1", "text": "相手が止まると考え、速度を保って通過する", "isRecommended": false, "feedback": "相手が止まる保証はなく、飛び出しに対応できない。"}, {"choiceId": "c2", "text": "警音器を鳴らして、車に止まるよう知らせる", "isRecommended": false, "feedback": "警音器はまず減速して対処してから。決められた場面以外では頼りにしない。"}, {"choiceId": "c3", "text": "減速して、車の動きを確かめながら通過する", "isRecommended": true, "feedback": "出入口では車が急に出てくることがある。減速して相手の動きを確かめる。"}]}, {"chapterId": "s2", "situation": "【場面2】道路わきに止まっている車のドアが少し開いたように見えた。", "choices": [{"choiceId": "c1", "text": "減速して車との間隔をあけ、ドアが開いても避けられるようにする", "isRecommended": true, "feedback": "ドアが開くことを想定し、間隔をあけて減速する。"}, {"choiceId": "c2", "text": "ドアが開くとは限らないので、そのまま車の近くを通る", "isRecommended": false, "feedback": "近くを通ると、急にドアが開いたとき避けられない。"}, {"choiceId": "c3", "text": "ドアと車体の間に入るように、急いで通過してしまう", "isRecommended": false, "feedback": "車の横を急いで通ると、接触の危険が大きい。"}]}, {"chapterId": "s3", "situation": "【場面3】駐車場の通路を走っている。見通しの悪い角から歩行者が出てきそう。", "choices": [{"choiceId": "c1", "text": "歩行者はいないものと思い込んで、角を速めに曲がる", "isRecommended": false, "feedback": "歩行者がいないと決めつけるのは危険。確かめずに曲がると衝突の恐れがある。"}, {"choiceId": "c2", "text": "角の手前で徐行し、歩行者が出てきても止まれる速度で進む", "isRecommended": true, "feedback": "見通しの悪い角は、止まれる速度で。歩行者は予期しない動きをする。"}, {"choiceId": "c3", "text": "警音器を鳴らして歩行者に知らせてから、速度を保ち曲がる", "isRecommended": false, "feedback": "警音器を使う前に、まず減速して安全を確かめる。"}]}, {"chapterId": "s4", "situation": "【場面4】歩道を横切って駐車場に入りたい。歩道には人が歩いている。", "choices": [{"choiceId": "c1", "text": "歩行者の前を、素早く横切ってそのまま駐車場に入る", "isRecommended": false, "feedback": "素早く横切ると、歩行者との接触の危険が高い。"}, {"choiceId": "c2", "text": "歩行者に気づいたら、その場で警音器を鳴らして進む", "isRecommended": false, "feedback": "警音器を鳴らして進むのではなく、止まって歩行者を優先する。"}, {"choiceId": "c3", "text": "歩道の手前で一時停止し、歩行者が通り過ぎてから進む", "isRecommended": true, "feedback": "歩道を横切るときは、歩行者の通行を妨げないよう一時停止し、通過を待つ。"}]}, {"chapterId": "s5", "situation": "【場面5】雨上がりの駐車場。路面が濡れていて、白線やマンホールも見える。", "choices": [{"choiceId": "c1", "text": "速度を落とし、白線やマンホールを避けて、ゆるやかに操作する", "isRecommended": true, "feedback": "濡れた白線やマンホールはすべりやすい。速度を落としてゆるやかに操作する。"}, {"choiceId": "c2", "text": "いつもと同じ速度で、濡れた白線の上を斜めに走って進む", "isRecommended": false, "feedback": "濡れた白線の上で斜めに走ると、タイヤがすべって転倒しやすい。"}, {"choiceId": "c3", "text": "効きを確かめるため、急ブレーキを練習のつもりでかける", "isRecommended": false, "feedback": "人や車のいる場所での急ブレーキの練習は危険。広い安全な場所で行う。"}]}], "source": "original", "sourceRef": "自作の架空シナリオ(AI下書き・専門家確認済み)。法令条文・既存問題は転載していない", "contentVer": "2"}
{"scenarioId": "bike_hazard-0010", "title": "危険予測(10) 通学路と子どもの飛び出し", "description": "学校の近くや通学路で、子どもの予測しにくい動きに備える場面です。", "chapters": [{"chapterId": "s1", "situation": "【場面1】学校の近くの道路。下校の時間で、子どもが多く歩いている。", "choices": [{"choiceId": "c1", "text": "子どもは避けると考え、いつもの速度で進む", "isRecommended": false, "feedback": "相手が避けてくれると考えるのは危険。急な動きに対応できない。"}, {"choiceId": "c2", "text": "速度を落とし、いつでも止まれるようにして進む", "isRecommended": true, "feedback": "子どもは急に走り出すことがある。止まれる速度で、動きに注意する。"}, {"choiceId": "c3", "text": "子どもの横を、警音器を鳴らしながら進む", "isRecommended": false, "feedback": "警音器でかえって驚かせるおそれがある。まず減速して間隔を確保する。"}]}, {"chapterId": "s2", "situation": "【場面2】道路わきの駐車車両の陰から、ボールが転がってきた。", "choices": [{"choiceId": "c1", "text": "ボールを避けて、そのままの速度で通過する", "isRecommended": false, "feedback": "ボールだけを避けても、後から出てくる子どもに対応できない。"}, {"choiceId": "c2", "text": "ボールが止まるのを見てから、減速するか考える", "isRecommended": false, "feedback": "様子を見てからでは遅い。ボールが見えた時点で、止まる準備をする。"}, {"choiceId": "c3", "text": "すぐに減速し、あとから子どもが出てくることに備える", "isRecommended": true, "feedback": "ボールの後ろから子どもが飛び出す可能性が高い。すぐに減速して備える。"}]}, {"chapterId": "s3", "situation": "【場面3】横断歩道の手前で、子どもが立ち止まって左右を見ている。", "choices": [{"choiceId": "c1", "text": "横断歩道の手前で止まり、子どもが渡るのを待つ", "isRecommended": true, "feedback": "立ち止まっていても、渡ろうとしているかもしれない。止まって待つのが安全。"}, {"choiceId": "c2", "text": "子どもが渡り始める前に、横断歩道を素早く通過する", "isRecommended": false, "feedback": "立ち止まっている子どもが急に渡ることがある。通過を急ぐのは危険。"}, {"choiceId": "c3", "text": "子どもに手を振って、渡るようにと先に合図を送る", "isRecommended": false, "feedback": "子どもは大人の合図を見落とすこともある。まず確実に止まる。"}]}, {"chapterId": "s4", "situation": "【場面4】通学路の交差点。信号は青だが、横断歩道に子どもの集団がいる。", "choices": [{"choiceId": "c1", "text": "青信号なので、横断中の集団の後ろをすり抜けて通過する", "isRecommended": false, "feedback": "集団の後ろを抜けても、遅れて渡る子どもがいるかもしれない。"}, {"choiceId": "c2", "text": "全員が渡り終えるまで待ち、安全を確かめてから発進する", "isRecommended": true, "feedback": "青信号でも、横断中の歩行者がいれば通行を妨げてはならない。全員が渡り終えるまで待つ。"}, {"choiceId": "c3", "text": "集団が途切れた間を見つけ、素早く通過してしまう", "isRecommended": false, "feedback": "間を抜ける行為は危険。最後の一人まで見届けてから発進する。"}]}, {"chapterId": "s5", "situation": "【場面5】学校の前の道で、通学バスが止まっている。子どもが乗り降りしている。", "choices": [{"choiceId": "c1", "text": "バスの横を、乗り降りする子どもを気にせずそのまま通る", "isRecommended": false, "feedback": "同じ速度で通ると、バスの陰から出てくる子どもに対応できない。"}, {"choiceId": "c2", "text": "バスの前に急いで出て、先に走り抜けてしまう", "isRecommended": false, "feedback": "バスの前に出ると、子どもが見えず危険。慌てて追い抜かない。"}, {"choiceId": "c3", "text": "バスの手前で止まるか、速度を大きく落として様子を見る", "isRecommended": true, "feedback": "乗り降りする子どもが、バスの前後から出てくる。止まるか大きく減速する。"}]}], "source": "original", "sourceRef": "自作の架空シナリオ(AI下書き・専門家確認済み)。法令条文・既存問題は転載していない", "contentVer": "2"}
{"scenarioId": "bike_hazard-0011", "title": "危険予測(11) 左折時の巻き込みと大型車", "description": "大型車の近くを走るときの死角や、左折時の巻き込みに備える場面です。", "chapters": [{"chapterId": "s1", "situation": "【場面1】前方のトラックが、方向指示器を出して左折しようとしている。自分はその左側を走っている。", "choices": [{"choiceId": "c1", "text": "トラックの左側に入らず、後ろで止まって曲がり終えるのを待つ", "isRecommended": true, "feedback": "大型車の左側は死角になりやすく、巻き込まれるおそれがある。後ろで待つのが安全。"}, {"choiceId": "c2", "text": "トラックの左側を、素早くすり抜けて先に行ってしまう", "isRecommended": false, "feedback": "左側をすり抜けると、曲がってきたトラックに巻き込まれる危険がある。"}, {"choiceId": "c3", "text": "警音器を鳴らして、トラックにその場で止まるよう知らせる", "isRecommended": false, "feedback": "警音器でトラックが止まる保証はない。自分から離れて待つ。"}]}, {"chapterId": "s2", "situation": "【場面2】信号待ちで大型バスの左斜め前に止まっている。信号が青になった。", "choices": [{"choiceId": "c1", "text": "バスの左側から、そのまますぐ前に出て発進してしまう", "isRecommended": false, "feedback": "バスの左側は死角が大きい。近くから急に前へ出ると接触の危険が高い。"}, {"choiceId": "c2", "text": "大型バスの動きを確かめ、バスが先に動き出すのを見てから発進する", "isRecommended": true, "feedback": "大型車のそばでは動きに注意する。バスが先に動いたのを確認してから発進するのが安全。"}, {"choiceId": "c3", "text": "バスが動き出す前に、急加速してバスの前へ出てしまう", "isRecommended": false, "feedback": "急加速で前に出ると、バスから見えず、巻き込まれたり接触したりする。"}]}, {"chapterId": "s3", "situation": "【場面3】左折したい交差点。左側の歩道には自転車が走っている。", "choices": [{"choiceId": "c1", "text": "自転車より先に、左後方を確認せず素早く左折してしまう", "isRecommended": false, "feedback": "先に曲がると、自転車と接触するおそれがある。"}, {"choiceId": "c2", "text": "左折の合図を出しただけで、そのまま曲がってしまう", "isRecommended": false, "feedback": "合図だけでは巻き込みを防げない。目で見て確認してから曲がる。"}, {"choiceId": "c3", "text": "左後方と歩道側を確認し、自転車の通過を待ってから左折する", "isRecommended": true, "feedback": "左折時は、左後方や歩道側の自転車や歩行者を確認する。通過を待ってから曲がる。"}]}, {"chapterId": "s4", "situation": "【場面4】大型トラックの後ろを走っている。トラックの運転席は高く、自分のミラーは小さく見える。", "choices": [{"choiceId": "c1", "text": "大型トラックとの間隔を広くとり、運転手から見える位置を意識する", "isRecommended": true, "feedback": "大型車の死角に入らないよう、間隔を広くとり、見えやすい位置を走る。"}, {"choiceId": "c2", "text": "トラックのすぐ後ろにぴったりついて、風よけに利用して走る", "isRecommended": false, "feedback": "すぐ後ろにつくと、急ブレーキに対応できず、運転手からも見えにくい。"}, {"choiceId": "c3", "text": "トラックのかげに隠れて、ほかの車から見えにくくして走る", "isRecommended": false, "feedback": "大型車の後ろは自分も見えにくくなる。あえて隠れる必要はない。"}]}, {"chapterId": "s5", "situation": "【場面5】交差点を直進しようとしている。対向車線では、大型トラックが右折のために止まって待っている。", "choices": [{"choiceId": "c1", "text": "止まっているので、そのままの速度で交差点を通過する", "isRecommended": false, "feedback": "止まっているように見えても、急に動き出すことがある。同じ速度では対応が遅れる。"}, {"choiceId": "c2", "text": "トラックが急に曲がり始めることを想定し、減速して動きを確かめる", "isRecommended": true, "feedback": "右折待ちの車は、対向車の切れ目で急に曲がり始めることがある。減速して動きを確かめる。"}, {"choiceId": "c3", "text": "トラックの横を、速度を上げて急いで通り抜けてしまう", "isRecommended": false, "feedback": "速度を上げると、曲がってきたトラックに対応できなくなる。"}]}], "source": "original", "sourceRef": "自作の架空シナリオ(AI下書き・専門家確認済み)。法令条文・既存問題は転載していない", "contentVer": "2"}
{"scenarioId": "bike_hazard-0012", "title": "危険予測(12) 前の車との車間距離", "description": "前の車にどのくらい近づくか、急ブレーキや割り込みにどう備えるかを選びます。", "chapters": [{"chapterId": "s1", "situation": "【場面1】前を走る車と同じ速度で走っている。前の車の間隔が詰まってきた。", "choices": [{"choiceId": "c1", "text": "前の車に合わせて、同じ間隔のままついていって走る", "isRecommended": false, "feedback": "同じ間隔のままでは、急ブレーキに間に合わないことがある。"}, {"choiceId": "c2", "text": "間隔をさらに詰めて、前の車の真後ろにぴったりつく", "isRecommended": false, "feedback": "ぴったりつくと、前の車が止まったときに追突する危険が高い。"}, {"choiceId": "c3", "text": "車間をあけ直し、前の車が急に止まっても止まれるようにする", "isRecommended": true, "feedback": "車間が詰まったら、早めにあけ直す。急停止にも対応できる間隔が必要。"}]}, {"chapterId": "s2", "situation": "【場面2】前の車のブレーキランプが点いたり消えたりしている。", "choices": [{"choiceId": "c1", "text": "速度を落として、車間を広めにとる", "isRecommended": true, "feedback": "ブレーキを繰り返す車の後ろでは、車間を広くとって備えるのが基本。"}, {"choiceId": "c2", "text": "ブレーキランプが消えたら、速度を上げて追いかける", "isRecommended": false, "feedback": "速度を上げて追うと、また急に止まられたときに間に合わない。"}, {"choiceId": "c3", "text": "ブレーキランプは気にせず、そのままの速度を保つ", "isRecommended": false, "feedback": "動きに関係なく同じ速度で走ると、急な減速に対応できない。"}]}, {"chapterId": "s3", "situation": "【場面3】前の車が急に左へ寄って、その先の駐車車両を避けようとしている。", "choices": [{"choiceId": "c1", "text": "前の車に続いて、同じ進路でそのまま避けて進んでいく", "isRecommended": false, "feedback": "同じ軌道で進むだけでは、駐車車両や歩行者への対応が遅れる。"}, {"choiceId": "c2", "text": "前の車の動きを見て減速し、避けたあとの様子を確認する", "isRecommended": true, "feedback": "前の車の動きの先を予測して減速し、その先に何があるか確かめる。"}, {"choiceId": "c3", "text": "前の車が行ったすきに、右側から急いで追い抜いてしまう", "isRecommended": false, "feedback": "右へ追い抜くと、対向車と接触する危険がある。"}]}, {"chapterId": "s4", "situation": "【場面4】雨で前が見えにくい。前の車のテールランプがぼんやり見える。", "choices": [{"choiceId": "c1", "text": "前の車のテールランプに頼って、近づいて走る", "isRecommended": false, "feedback": "ぼんやりした光に頼って近づくと、止まった前の車に気づくのが遅れる。"}, {"choiceId": "c2", "text": "雨なので、車間を詰めて前の車の水はねを避ける", "isRecommended": false, "feedback": "車間を詰めると、前の車が止まったときに追突する危険が高い。"}, {"choiceId": "c3", "text": "いつもより車間を広くとり、速度を落として進む", "isRecommended": true, "feedback": "視界が悪いときは車間を広めにとり、止まる余裕を作る。"}]}, {"chapterId": "s5", "situation": "【場面5】後ろの車が、すぐ後ろにぴったりついてきている。", "choices": [{"choiceId": "c1", "text": "左に寄って道を譲り、速度を保って安全に走る", "isRecommended": true, "feedback": "後ろの車が気になっても、安全な範囲で道を譲る。無理な運転で対応しない。"}, {"choiceId": "c2", "text": "後ろの車に腹を立てて、わざと速度を落とす", "isRecommended": false, "feedback": "わざと速度を落とすと、かえって追突などの危険が高まる。"}, {"choiceId": "c3", "text": "後ろの車を気にして、急に速度を上げて引き離す", "isRecommended": false, "feedback": "急な加速は、自分の安全を損なう。落ち着いて対処する。"}]}], "source": "original", "sourceRef": "自作の架空シナリオ(AI下書き・専門家確認済み)。法令条文・既存問題は転載していない", "contentVer": "2"}
{"scenarioId": "bike_hazard-0013", "title": "危険予測(13) 交差点での右折", "description": "交通量の多い交差点で、右折のタイミングや対向車との関係を判断する場面です。", "chapters": [{"chapterId": "s1", "situation": "【場面1】交差点で右折したい。対向車線に直進車が見え、まだ少し距離がある。", "choices": [{"choiceId": "c1", "text": "距離があるので、確認せずにそのまま右折を始めてしまう", "isRecommended": false, "feedback": "遠く見えても、速度が高ければ短時間で近づく。"}, {"choiceId": "c2", "text": "直進車の速度と距離を確かめ、安全に曲がれるか判断する", "isRecommended": true, "feedback": "対向車の速度は、遠いほど判断しにくい。確かめて、安全な間隔があるときだけ曲がる。"}, {"choiceId": "c3", "text": "直進車が止まってくれると考え、そのまま右折を始める", "isRecommended": false, "feedback": "相手が止まるとは限らない。自分の判断だけで曲がらない。"}]}, {"chapterId": "s2", "situation": "【場面2】右折を始めようとしたとき、対向車がライトを点滅させた。", "choices": [{"choiceId": "c1", "text": "合図を信じて、周囲の確認はせずにすぐ右折を始める", "isRecommended": false, "feedback": "合図だけを信じると、後ろから来る別の車に気づけない。"}, {"choiceId": "c2", "text": "合図を気にせず、そのままの勢いで右折を始めてしまう", "isRecommended": false, "feedback": "相手の合図を無視しても、危険が増すだけ。確認してから動く。"}, {"choiceId": "c3", "text": "意図を確かめて、安全が確認できるまで待つ", "isRecommended": true, "feedback": "ライトの点滅の意味が、いつも「先に行け」とは限らない。安全を確かめてから動く。"}]}, {"chapterId": "s3", "situation": "【場面3】右折待ちの途中。対向車が途切れ、横断歩道に歩行者が渡り始めた。", "choices": [{"choiceId": "c1", "text": "歩行者が渡り終えるのを待ってから、右折する", "isRecommended": true, "feedback": "横断中の歩行者は優先。渡り終えるまで待ってから、安全を確かめて右折する。"}, {"choiceId": "c2", "text": "歩行者の前を、素早く右折して通過する", "isRecommended": false, "feedback": "歩行者の前を通ると、接触の危険があり、通行を妨げる。"}, {"choiceId": "c3", "text": "歩行者が渡る前に、警音器を鳴らす", "isRecommended": false, "feedback": "警音器は決められた場面以外では使わない。待つのが基本。"}]}, {"chapterId": "s4", "situation": "【場面4】右折の途中、対向車が先に通過しようとしている。自分はまだ交差点の中央付近。", "choices": [{"choiceId": "c1", "text": "対向車より先に曲がりきるため、加速する", "isRecommended": false, "feedback": "加速して曲がると、対向車との接触や転倒の危険がある。"}, {"choiceId": "c2", "text": "無理に曲がらず、対向車に進路を譲り安全な位置で待つ", "isRecommended": true, "feedback": "対向車が近いときは無理に曲がらず、譲る。安全な位置で待ってから進む。"}, {"choiceId": "c3", "text": "その場で停止して動かず、対向車の様子を見続ける", "isRecommended": false, "feedback": "交差点の中央で止まり続けると、ほかの車の通行を妨げ、危険が高まる。"}]}, {"chapterId": "s5", "situation": "【場面5】右折後、すぐ先の路肩に自転車が止まっている。自転車が動き出しそう。", "choices": [{"choiceId": "c1", "text": "自転車が動かないと考え、速度を上げる", "isRecommended": false, "feedback": "相手の動きを決めつけると、急な動きに対応できない。"}, {"choiceId": "c2", "text": "自転車との間隔を詰めて、素早く追い抜く", "isRecommended": false, "feedback": "間隔を詰めて追い抜くのは危険。余裕を持って通過する。"}, {"choiceId": "c3", "text": "減速して、自転車の動きに注意しながら進む", "isRecommended": true, "feedback": "動き出すかもしれない自転車の近くでは減速し、間隔をとる。"}]}], "source": "original", "sourceRef": "自作の架空シナリオ(AI下書き・専門家確認済み)。法令条文・既存問題は転載していない", "contentVer": "2"}
{"scenarioId": "bike_hazard-0014", "title": "危険予測(14) 乗る前の準備と体調管理", "description": "走り出す前の点検や服装、体調の確かめ方など、事故を防ぐための準備を選びます。", "chapters": [{"chapterId": "s1", "situation": "【場面1】出かける前、バイクの前後のタイヤを見ると、片方の空気が少なそうに感じる。", "choices": [{"choiceId": "c1", "text": "走る前に空気圧を確かめ、足りなければ補充する", "isRecommended": true, "feedback": "空気圧の不足は、転倒やパンクの原因。出発前に確かめて補充する。"}, {"choiceId": "c2", "text": "少なめなだけなので、そのまま出発する", "isRecommended": false, "feedback": "少ないまま走ると、バランスをくずしやすく危険。"}, {"choiceId": "c3", "text": "走っているうちに戻るだろうと考えて出発する", "isRecommended": false, "feedback": "自然に戻ることはなく、走行中に悪化することもある。"}]}, {"chapterId": "s2", "situation": "【場面2】夏の暑い日。薄着で出かけようとしている。", "choices": [{"choiceId": "c1", "text": "暑いので、半袖と半ズボンで出かける", "isRecommended": false, "feedback": "薄着だと、転んだときの傷が大きくなる。"}, {"choiceId": "c2", "text": "長袖や手袋、プロテクターなど、体を守る服装を選ぶ", "isRecommended": true, "feedback": "暑くても、転倒に備えて肌を覆う服装と手袋をすると、けがを軽くできる。"}, {"choiceId": "c3", "text": "ヘルメットだけかぶっていれば十分だと考える", "isRecommended": false, "feedback": "ヘルメットだけでは、体の他の部分を守れない。"}]}, {"chapterId": "s3", "situation": "【場面3】体調が少し悪く、頭が重い感じがする。", "choices": [{"choiceId": "c1", "text": "少しなので、気にせず運転する", "isRecommended": false, "feedback": "小さな不調でも、集中力が下がり事故につながる。"}, {"choiceId": "c2", "text": "風にあたれば治ると考えて運転する", "isRecommended": false, "feedback": "風にあたっても体調は回復しない。運転を避ける方が安全。"}, {"choiceId": "c3", "text": "無理せず休むか、ほかの交通手段を選ぶ", "isRecommended": true, "feedback": "体調が悪いと判断力や反応が落ちる。無理をせず、運転しないという選択もある。"}]}, {"chapterId": "s4", "situation": "【場面4】出発の直前に、携帯端末へ連絡が入った。画面を確認したい。", "choices": [{"choiceId": "c1", "text": "安全な場所に止まり、エンジンを止めてから確認する", "isRecommended": true, "feedback": "連絡の確認は、安全な場所に止めて行う。走行中の画面操作は危険。"}, {"choiceId": "c2", "text": "走り出してから、片手で携帯端末の画面を見て確かめる", "isRecommended": false, "feedback": "走りながらの画面確認は、前方から注意が離れて危険。"}, {"choiceId": "c3", "text": "信号待ちのたびに、長めに携帯端末の画面を見て確認する", "isRecommended": false, "feedback": "信号待ちでも、発進のタイミングを逃し、周りが見えなくなる。"}]}, {"chapterId": "s5", "situation": "【場面5】雨具を着たが、足元が滑りやすいブーツのまま乗車しようとしている。", "choices": [{"choiceId": "c1", "text": "気にせず、そのまま乗って出発する", "isRecommended": false, "feedback": "滑りやすい靴だと、停車時に足が滑って転倒するおそれがある。"}, {"choiceId": "c2", "text": "足がすべりにくい靴に履き替えてから乗る", "isRecommended": true, "feedback": "足元がすべると、停止や発進のときに支えられなくなる。すべりにくい靴を選ぶ。"}, {"choiceId": "c3", "text": "足をステップにのせず、浮かせて走る", "isRecommended": false, "feedback": "足を浮かせて走ると、バランスをくずして危険。"}]}], "source": "original", "sourceRef": "自作の架空シナリオ(AI下書き・専門家確認済み)。法令条文・既存問題は転載していない", "contentVer": "2"}
